# Build outputs. Several GB, and GitHub rejects any single file over 100 MB --
# the Electron framework binary alone is 170.8 MB.
dist/
jsons/dist/
dist-react/
jsons/dist-react/

# Packaged application payloads (~115 MB app.asar each).
resources/
locales/
*.asar
*.zip
*.dmg
*.blockmap

# The Windows Electron runtime, extracted at the project root by earlier builds.
# The macOS runner downloads its own Electron; none of this is source.
Senior Law Partner.exe
*.dll
*.pak
*.node
*.bin
*.dat
snapshot_blob.bin
v8_context_snapshot.bin
vk_swiftshader_icd.json
icudtl.dat
LICENSE.electron.txt
LICENSES.chromium.html

# The staged corpus copy made by the workflow. The source of truth is
# icm/references/florida-statutes, which IS committed. No trailing slash: the
# directory does not exist yet, and a trailing slash only matches real directories.
jsons/references

# Dependencies.
node_modules/
jsons/node_modules/

# Local noise.
debug.log
*.log
.DS_Store
Thumbs.db

# Secrets. Never commit these. .env.local holds VITE_DEEPSEEK_KEY, which Vite
# inlines into the renderer bundle at build time; CI writes it from the
# DEEPSEEK_KEY repository secret instead.
.env
.env.local
.env.*.local
*.pem
*.p12
*.key

# One-off dev scripts from the mock-exam era. They contain a hardcoded API key
# (sk-4d35...daff, a third credential predating the rotated one) and are not part of
# the shipped app. Kept on disk so they keep working locally, kept out of the repo so
# the literal never lands in history. The proper fix next cycle is to read
# os.environ.get('DEEPSEEK_KEY') in each, at which point they can be committed.
apply_dewolf_style.py
fix_set3.py
fix_set3_properly.py
gen_set2_key.py
gen_set3_key.py
generate_exam_variants.py
generate_mock_exam.py
